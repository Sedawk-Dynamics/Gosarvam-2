# Copy this file to .env.local and fill in your values.

# Password for the /admin dashboard (change this!)
ADMIN_KEY=gosarvam-admin-2025

# Email notifications for RFQ and Contact submissions (optional).
# Without these the forms still succeed and still save locally — they just
# don't send mail. Create a Gmail App Password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password

# Where form notification emails are delivered
NOTIFY_EMAIL=trade@gosarvamglobal.com
